<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!--
            Story 24 (WIS-23): the Ticket::created classification observer would
            otherwise fire a live Groq call (api/.env carries a real key) on the
            terminate of every ticket-creating feature test. The suite must pass
            with the FAKE generator and never depend on the live key, so the
            feature is OFF by default here; the classification/chat test files
            opt back in with config(['ai.classify.enabled' => true]) and bind a
            fake.
        -->
        <env name="AI_CLASSIFY_ENABLED" value="false"/>
        <!--
            Story 25 (WIS-24): the outbound event enqueue fires from Ticket::created,
            Ticket::updated and CsatSurveyController@store — three of the busiest
            paths in the suite. OFF by default so no existing test starts writing
            integration_outbox rows; the sync test files opt back in with
            config(['integrations.sync.enabled' => true]) and Http::fake().
        -->
        <env name="INTEGRATION_SYNC_ENABLED" value="false"/>
        <!--
            Story 26 (WIS-22): the outbound delivery enqueue fires from
            TicketMessageController@store — one of the busiest paths in the suite — and
            ingestion writes tickets. OFF by default so no existing thread test starts
            writing channel_outbound_messages; the channel test files opt back in with
            config(['channels.enabled' => true]).
        -->
        <env name="CHANNELS_ENABLED" value="false"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run on a LOCAL PostgreSQL database, not SQLite :memory:.

            Why not SQLite: php_pdo_sqlite.dll is blocked by a Windows Application Control
            policy on the dev machine, so every test errored with "could not find driver".
            See docs/debugging/002-pdo-sqlite-blocked.md.

            Why Postgres and not MySQL: production is Postgres (Supabase), and the schema
            relies on Postgres features MySQL/MariaDB does not have — e.g. the partial unique
            index in 2026_08_27_111743_create_customers_table.php:34
            ("CREATE UNIQUE INDEX ... WHERE ..."). Testing on Postgres keeps the test engine
            and the production engine the same, so driver-specific bugs surface here first.

            One-time setup per machine (see docs/debugging/002-pdo-sqlite-blocked.md):
              CREATE ROLE wisal_test LOGIN PASSWORD 'wisal_test';
              CREATE DATABASE wisal_testing OWNER wisal_test;

            The credentials below are a throwaway LOCAL-ONLY role for an empty scratch
            database. They are not a secret and grant nothing outside this machine.

            Not a lock-in: PHPUnit's <env> does NOT overwrite a variable that already exists
            in the real environment, so CI (or a machine with pdo_sqlite working) can switch
            back by exporting DB_CONNECTION=sqlite and DB_DATABASE=:memory: before running.

            NEVER point these at the Supabase instance configured in .env — RefreshDatabase
            truncates every table it touches.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="wisal_testing"/>
        <env name="DB_USERNAME" value="wisal_test"/>
        <env name="DB_PASSWORD" value="wisal_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
